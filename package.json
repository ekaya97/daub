{
  "name": "daub",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @daub/core build && pnpm --filter @daub/overlay build && pnpm --filter @daub/vite-plugin build && pnpm --filter @daub/next build",
    "dev": "pnpm --filter @daub/core dev & pnpm --filter @daub/overlay dev",
    "test": "pnpm -r test",
    "lint": "eslint packages/*/src --ext .ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.9.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@9.15.0"
}
